# Blank template only. Use your own event-issued key in a local .env or the
# hosting provider's server-side secret store. Never use a VITE_ key variable.
QLOO_API_KEY=
QLOO_ENABLED=false
QLOO_OPERATOR_APPROVED=false
# Explicit owner approval for the bounded event demo despite unresolved issuer
# terms. This is NOT evidence that the issuer confirmed free access or hosting.
QLOO_EVENT_DEMO_OPERATOR_APPROVED=false
QLOO_FREE_ACCESS_CONFIRMED=false
QLOO_HOSTING_PERMITTED_CONFIRMED=false
# Local operator caps/stop time, not assertions of published vendor limits.
QLOO_EVENT_QUOTA=
QLOO_EVENT_RATE_PER_MINUTE=
QLOO_ACCESS_EXPIRES_AT=
# File-budget production mode needs a durable data/ mount for its five-attempt cap.
QLOO_PERSISTENT_STORAGE_CONFIRMED=false
# Ephemeral hosts require Postgres; verify the host's actual no-charge plan.
QLOO_BUDGET_BACKEND=file
QLOO_BUDGET_DATABASE_URL=
# The issued project key has already consumed five requests in local validation.
QLOO_PRIOR_HTTP_ATTEMPTS=5
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
